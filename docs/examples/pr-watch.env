# Starting point to copy into local config/pr-watch.env (gitignored).
# Read by bin/fm-pr-watch.sh; see docs/configuration.md for the schema.
#
# Every value here is per-machine: which forge account these repositories live
# under, which repositories this home watches, and which account logins count as
# ours. All three are required, and the check refuses to arm without them rather
# than watching nothing.

# The forge owner or organisation the repositories below live under.
FM_PR_WATCH_OWNER=your-org

# The repositories this home watches, space separated, names only.
FM_PR_WATCH_REPOS="service-one service-two web-app"

# The account logins that count as ours: a PR by one of these is our own work to
# review before a human is asked to look at it, and a review comment by one of
# these is not something to wake for.
FM_PR_WATCH_OURS="your-work-login your-personal-login"

# Optional per-mode repository lists. Each falls back to FM_PR_WATCH_REPOS.
# Watching our own PRs across every repository we push to is cheap; reviewing
# everyone else's is a choice, so the lists do not have to match.
#FM_PR_WATCH_REPOS_OURS="service-one service-two web-app infra release-tools"
#FM_PR_WATCH_REPOS_NEW="service-one service-two"
#FM_PR_WATCH_REPOS_COMMENTS="service-one service-two web-app"
